{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/admin.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}